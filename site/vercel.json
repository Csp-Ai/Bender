{
  "version": 2,
  "functions": {
    "api/candles.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "buildCommand": "npm test",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/research-bets",
      "destination": "https://research-bets-git-feat-v12-a7883a-christopher-s-ponces-projects.vercel.app/research-bets"
    },
    {
      "source": "/research-bets/:path*",
      "destination": "https://research-bets-git-feat-v12-a7883a-christopher-s-ponces-projects.vercel.app/research-bets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://research-bets-git-feat-v12-a7883a-christopher-s-ponces-projects.vercel.app/research-bets/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://research-bets-git-feat-v12-a7883a-christopher-s-ponces-projects.vercel.app/research-bets/:path*"
    }
  ]
}
